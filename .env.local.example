# Personal OCR credentials for the doc-extract-web website (./run.sh).
# Gemini / Vertex extraction always uses company mllm-invoker/.env.local.

# ── Google OCR (Cloud Vision API) — pick ONE auth method ───────────────────
# GCP_PROJECT_ID=your-personal-gcp-project

# Option A: API key (Credentials → Create credentials → API key, restrict to Vision API)
# Requires billing enabled on the project.
# GOOGLE_CLOUD_API_KEY=

# Option B: Service account JSON path (blocked if org policy iam.disableServiceAccountKeyCreation)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Option C: gcloud login — no JSON key needed (recommended when org blocks key download)
#   gcloud auth application-default login --project=YOUR_PROJECT_ID
# Leave GOOGLE_CLOUD_API_KEY and GOOGLE_APPLICATION_CREDENTIALS unset.

# ── Gemini extraction ──────────────────────────────────────────────────────
# Always uses company Vertex / API creds from mllm-invoker/.env.local — do not set here.

# Optional model override (default from company env or gemini-3.1-flash-lite)
# DOC_EXTRACT_GEMINI_MODEL=gemini-2.5-flash

# OpenCV printed-box sectioning (OCR → redact text → detect frames on redacted image)
# DOC_EXTRACT_OPENCV_BOXES=1
# DOC_EXTRACT_OPENCV_BOX_MIN_CONF=0.9

# Section gate — self-hosted small LLM (default; no Gemini API spend)
# DOC_EXTRACT_SECTION_GATE=1
# DOC_EXTRACT_GATE_PROVIDER=local
# DOC_EXTRACT_GATE_BASE_URL=http://127.0.0.1:11434/v1
# DOC_EXTRACT_GATE_MODEL=qwen2.5:3b
# Vision gate: ollama pull qwen2.5vl:3b
# DOC_EXTRACT_GATE_MODEL=qwen2.5vl:3b
# DOC_EXTRACT_GATE_USE_IMAGE=   (omit = auto on for *vl* models)
# Cloud fallback only: DOC_EXTRACT_GATE_PROVIDER=gemini

# ── Sign-in (email + password — primary) ───────────────────────────────────
# Required for auth when DOC_EXTRACT_AUTH_REQUIRED=true (default):
DOC_EXTRACT_JWT_SECRET=change-me-to-a-long-random-string

# Optional Google button (not required for email signup):
# GOOGLE_OAUTH_CLIENT_ID=
# For Vite frontend only (same client ID as above):
# VITE_GOOGLE_CLIENT_ID=
# Set to false to skip login during local UI work
# DOC_EXTRACT_AUTH_REQUIRED=false

# ── User emails (Google sign-in) — SQLite, no AWS/Redshift ─────────────────
# Default: <DOC_EXTRACT_JOB_ROOT>/../data/users.sqlite (local) or set explicitly:
# DOC_EXTRACT_USERS_DB=/var/data/users.sqlite
# DOC_EXTRACT_DATA_DIR=/var/data
# DOC_EXTRACT_USERS_TABLE=docparse_users
# DOC_EXTRACT_INITIAL_CREDITS=20
# DOC_EXTRACT_CREDITS_PER_PAGE=2
